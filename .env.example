# Copy to .env and fill in. Never commit .env.

# Database (Neon). DATABASE_URL = dev branch (local work, evals); DATABASE_URL_PROD = main branch.
DATABASE_URL=
DATABASE_URL_PROD=

# Models (spec §8.1). Names come from here, never from code.
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-sonnet-5-5
MODEL_SMALL=claude-haiku-5-5

# Embeddings (ADR 0005)
VOYAGE_API_KEY=
EMBEDDING_MODEL=

# Tracing (ADR 0004)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Cost guards (spec §16)
DAILY_BUDGET_USD=1.00

# Web
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
