    "sql": [
      {
        "result_id": "r1",
        "tool": "get_metric",
        "sql": "select t.region as region, round(100.0 * avg(t.is_sla_breached::int), 2) as sla_breach_rate\nfrom marts.fct_tickets as t\nwhere t.opened_date between %(start_date)s and %(end_date)s and t.priority = any(%(filter_0)s)\ngroup by 1\norder by 2 desc nulls last\nlimit %(row_limit)s",
